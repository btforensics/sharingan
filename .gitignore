# ─────────────────────────────────────────────────────────────────────────
#  SAFETY-CRITICAL — never commit these
# ─────────────────────────────────────────────────────────────────────────
# Live API keys (copy config.env.example -> config.env and fill locally)
config.env

# Live malware samples — pushing these violates GitHub's TOS and is dangerous
samples/

# Generated triage output (contains live IOCs; regenerable via triage.sh)
reports/

# ─────────────────────────────────────────────────────────────────────────
#  Third-party tooling — installed locally via the setup scripts, not vendored
# ─────────────────────────────────────────────────────────────────────────
# Detect-It-Easy engine clone (~550 MB, has its own git history)
tools/DIE-engine/
# pestats clone (third-party, has its own git history)
tools/pestats/
# Rule sets — capa-rules / capa-sigs / yara-rules / signature-base clones (bulk
# upstream checkouts, bootstrapped locally — not committed). Use rules/* (not
# rules/) so we can re-include curated, project-owned rule files below; git can't
# un-ignore a file whose parent DIRECTORY is excluded.
rules/*
# ...but the analyst-maintained abused/stolen code-signing cert list (N6) IS ours
# and must travel with the repo (team-distributed — config lives in committed files).
!rules/abused_certs.json
# Per-analyst Python venv (oletools/LnkParse3/Speakeasy/...) — built by setup-env.sh
tools/venv/
# Per-analyst de4dot build for the N7 .NET-deob stage — built by install-dotnet-deob.sh
# (like the venv / Ghidra, reproduced locally, not committed).
tools/de4dot/
tools/de4dot-src/

# ─────────────────────────────────────────────────────────────────────────
#  Python / editor / local Claude Code cruft
# ─────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.claude/settings.local.json
