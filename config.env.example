# Sharingan triage config — sourced by triage.sh
# ─────────────────────────────────────────────────────────────────────────
# SETUP: copy this file to `config.env` and fill in your own API keys.
#   cp config.env.example config.env
# `config.env` is gitignored (it holds live secrets) — never commit it.
# ─────────────────────────────────────────────────────────────────────────
# Paths are derived from this file's own location so the project stays portable
# across machines and survives being moved/renamed (team-distributed tool).
BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── API keys (get your own free keys from each service) ──
# VirusTotal:  https://www.virustotal.com/gui/my-apikey
VT_API_KEY=YOUR_VIRUSTOTAL_API_KEY_HERE
# AbuseIPDB:   https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY_HERE
# abuse.ch unified Auth-Key — one key authenticates MalwareBazaar, ThreatFox, and URLhaus
# https://auth.abuse.ch/
BAZAAR_API_KEY=YOUR_ABUSECH_AUTH_KEY_HERE

CAPA_RULES="$BASE/rules/capa-rules"
CAPA_SIGS="$BASE/rules/capa-sigs"
YARA_RULES_DIR="$BASE/rules"
PESTATS="$BASE/tools/pestats/pestats.py"
DOMAINREP="$BASE/tools/domain_rep.py"
VTPIVOT="$BASE/tools/vt_pivot.py"
PROVENANCE="$BASE/tools/provenance.py"
IDENTIFY="$BASE/tools/identify.py"
NONPE="$BASE/tools/nonpe.py"
COLLECT="$BASE/tools/collect_strings.py"
# Emulation-based unpacking (N4) — opt-in via `./triage.sh <sample> --unpack`.
# Emulates the loader stub in Speakeasy (installed in the venv by setup-env.sh)
# and carves the decrypted payload from memory; triage.sh then re-runs the binary
# tools on the recovered body. Sandbox-free arm of roadmap #4.
UNPACK="$BASE/tools/unpack_emulate.py"
# Automated config / C2 extraction (N2) — configextractor-py + CAPE/rat-king
# parser packs (installed in the venv by setup-env.sh). Statically rips the
# embedded config (C2/keys/campaign IDs/mutex) from recognized families.
CONFIGEXT="$BASE/tools/config_extract.py"
# Project-local venv for non-PE deps (oletools/LnkParse3/extract_msg).
# Created per-analyst by tools/setup-env.sh; not committed. triage.sh falls back
# to system python3 (and skips Office/LNK/email stages) if the venv is absent.
VENV_PY="$BASE/tools/venv/bin/python"
OLEVBA="$BASE/tools/venv/bin/olevba"
OLEID="$BASE/tools/venv/bin/oleid"
# Ghidra deep-RE stage (optional; only used with `./triage.sh <sample> --deep`)
GHIDRA_HOME=/opt/ghidra
GHIDRA_SCRIPTS="$BASE/tools/ghidra"
